# Copy to backend/.env and adjust. Never commit the real .env.
DATABASE_URL=sqlite:///./timemachine.db
DEBUG=false
# Set to true when served over HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
# JSON list of origins allowed to send state-changing requests
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Optional: one fixed password for all demo users. Empty = `make seed` generates random ones.
DEMO_PASSWORD=
